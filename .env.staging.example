# Copy into the STAGING_ENV GitHub secret. Never commit the filled file.
# Compose reads this for interpolation and passes it to API and worker.
GETTER_API_DOMAIN=api-staging.example.com
GETTER_DATABASE_URL=postgresql+psycopg://USER:PASSWORD@NEON_HOST/getter_staging?sslmode=require
GETTER_CLERK_ISSUER=https://YOUR_INSTANCE.clerk.accounts.dev
GETTER_CLERK_JWKS_URL=https://YOUR_INSTANCE.clerk.accounts.dev/.well-known/jwks.json
GETTER_CLERK_AUTHORIZED_PARTIES=["https://getter-staging.pages.dev"]
GETTER_CORS_ORIGINS=["https://getter-staging.pages.dev"]
# No model keys required: offline config is the default.
# GETTER_LLM_CONFIG=/app/src/getter_api/llm/llm.example.yaml
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# OPENROUTER_API_KEY=
# GEMINI_API_KEY=
# The Compose file pins staging, Clerk and Redis; do not enable dev auth.

# GitHub repository secrets (not runtime settings in this file):
# STAGING_SSH_HOST=
# STAGING_SSH_USER=
# STAGING_SSH_KEY=
# STAGING_SSH_KNOWN_HOSTS=
# STAGING_ENV=  # Filled contents of this file.
# CLOUDFLARE_API_TOKEN=
# CLOUDFLARE_ACCOUNT_ID=
# GitHub repository variables:
# CLOUDFLARE_PAGES_PROJECT=
# STAGING_API_URL=
# STAGING_CLERK_PUBLISHABLE_KEY=
