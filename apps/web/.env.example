# Where the browser finds the API.
NEXT_PUBLIC_API_URL=http://localhost:8000
# Set for Clerk sign-in; leave unset for the offline development email flow.
# NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
# Optional monitoring, build-time. Unset means nothing is loaded or sent.
# NEXT_PUBLIC_SENTRY_DSN=
# NEXT_PUBLIC_POSTHOG_KEY=
# NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
# Where privacy and account-deletion requests go (shown on the privacy page).
# NEXT_PUBLIC_CONTACT_EMAIL=
