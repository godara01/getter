# Copy to .env for local runs. Every setting has a working default.
GETTER_DATABASE_URL=sqlite+aiosqlite:///./getter-dev.db
# GETTER_DATABASE_URL=postgresql+psycopg://getter:getter@localhost:5432/getter
GETTER_CORS_ORIGINS=["http://localhost:3000"]

# Real models: point at a routing config and set the keys it names.
# GETTER_LLM_CONFIG=/path/to/llm.yaml
# OPENROUTER_API_KEY=
# GEMINI_API_KEY=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# Free-session admission limits; the offline model costs zero.
# GETTER_FREE_SESSIONS_PER_DAY=3
# GETTER_FREE_ACCOUNT_COST_INR=100
# GETTER_FREE_COST_WINDOW_HOURS=24
# GETTER_GLOBAL_DAILY_COST_INR=300
# GETTER_SESSION_COST_WARNING_INR=50
